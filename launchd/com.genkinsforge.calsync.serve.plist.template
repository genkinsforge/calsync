<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.genkinsforge.calsync.serve</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON3__</string>
    <string>-m</string>
    <string>calsync</string>
    <string>serve</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__CALSYNC_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>__CALSYNC_DIR__</string>
  </dict>
  <!-- Background lets the job load with `launchctl bootstrap user/<uid>` when the studio
       has rebooted with nobody logged in; Aqua covers a normal logged-in session. -->
  <key>LimitLoadToSessionType</key>
  <array>
    <string>Aqua</string>
    <string>Background</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/calsync/serve.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/calsync/serve.log</string>
</dict>
</plist>
